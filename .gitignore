
# C 编译产物 (课件 code 目录里 gcc 生成的可执行文件与调试符号)
cpl/slides/*/code/*
!cpl/slides/*/code/*.c
!cpl/slides/*/code/*.h
!cpl/slides/*/code/*.js
!cpl/slides/*/code/Makefile
!cpl/slides/*/code/*.txt
!cpl/slides/*/code/.vscode/
!cpl/slides/*/code/.vscode/*

# OJ 上机作业 (含答案, 不入库)
cpl/CPL-oj/

# 讲义 (含小测答案, 不入库)
cpl/slides/讲义/
